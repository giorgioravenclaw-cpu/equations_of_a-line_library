def risolvere_equazione_primo_grado_info_date_dall_utente():

    
    Xa=input("dimmi lequazione ")
    N1=input("dimmi il risultato che deve avere")

    sp.simplify=(N1)
    sp.simplify=(Xa)

    Xa = sp.sympify(Xa)

    simboli = Xa.free_symbols

    

    if simboli:
        incognita=list(simboli)[0]
    else:
       incognita=None 
    
    risultato=sp.solve(sp.Eq(Xa, N1), incognita)

    return risultato

