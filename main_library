def distanza_tra_2_punti(Xa,Ya,Xb,Yb):

    X=(Xa-Xb)**2
    Y=(Ya-Yb)**2

    XY=math.sqrt((X+Y))

    return XY


#Area=1/2​∣XA​(YB​−YC​)+XB​(YC​−YA​)+XC​(YA​−YB​)∣
#formula del determinante
def area_triangolo(Xa, Ya, Xb, Yb, Xc, Yc):

     area = abs(Xa*(Yb-Yc) + Xb*(Yc-Ya) + Xc*(Ya-Yb)) / 2
     return area



def altezza_relativa_AB(Xa, Ya, Xb, Yb, Xc, Yc):
    area = area_triangolo(Xa, Ya, Xb, Yb, Xc, Yc)
    base = distanza_tra_2_punti(Xa, Ya, Xb, Yb)
    
    altezza = (2 * area) / base
    return altezza

