def calcola_coefficente_angolare(X1,Y1,X2,Y2):

    X1 = sp.sympify(X1)
    Y1 = sp.sympify(Y1)
    X2 = sp.sympify(X2)
    Y2 = sp.sympify(Y2)

    if X1-X2==0:
        return None

    m=(Y1-Y2)/(X1-X2)
    return m


