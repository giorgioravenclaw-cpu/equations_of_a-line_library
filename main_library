def trova_equazione_retta():
    
    Xa,Ya,Xb,Yb=acquisisci_due_punti()

    Xa=sp.sympify(Xa)
    Ya=sp.sympify(Ya)
    Xb=sp.sympify(Xb)
    Yb=sp.sympify(Yb)
    
    m=calcola_coefficente_angolare(Xa,Ya,Xb,Yb)

